# Copy to homelab.env (gitignored). Pass --env-file homelab.env to every Compose command.
# Compose settings. Pin KR_IMAGE to a published sha-<full commit> tag for repeatable deployments.
KR_IMAGE=ghcr.io/cyberst0rm1/kongroyale:latest
KR_BIND_ADDRESS=0.0.0.0
KR_PUBLISH_PORT=3020
KR_MEMORY_LIMIT=2g

# Game runtime. Host must stay 0.0.0.0 inside the container for published ports to work.
KR_HOST=0.0.0.0
KR_PORT=3020
KR_SERVE=1
KR_EVENT_MODE=0
KR_ORIGINS=https://kong.cyber.gs,http://localhost:3020
KR_SECURE_COOKIE=1
KR_TRUST_PROXY=0
# When enabling proxy trust, list only the actual cloudflared connector IP, not an entire subnet.
KR_PROXY_IPS=
KR_PERF_METRICS=0
KR_ANNOTATE=0
KR_MAX_CONNS=2000
KR_MAX_PER_IP=120
KR_HEARTBEAT_TIMEOUT_S=30
KR_RESERVED_NAMES=
KR_BASE_PATH=
# Set a random stable value locally; never commit it.
KR_IP_SALT=

# Optional admin/event console: set ONLY the SHA-256 hash, never the admin key itself.
KR_ADMIN_KEY_SHA256=
KR_ADMIN_ORIGINS=https://kong.cyber.gs
KR_ADMIN_ALLOW_IPS=
KR_ADMIN_SESSION_S=43200

# Optional external/private MongoDB for reports. Unavailable Mongo falls back to the reports volume.
# KR_MONGO_URI=mongodb://your-private-mongodb:27017
KR_MONGO_DB=kong_royale

# Browser BUILD settings: changing these requires rebuilding the image, not just restarting it.
# 0 enables Friends, Solo/Trios and bot difficulty; 1 enables the simplified event title screen.
VITE_KR_PLAYTEST=0
DEPLOY_BASE=/

# Voice uses the existing STUN/direct WebRTC implementation. There is no TURN env setting upstream.
